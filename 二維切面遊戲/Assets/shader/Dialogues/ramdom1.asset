  lines:
  - speakerName: "\u5947\u602A\u7684\u760B\u5B50"
    speakerSide: 0
    avatarSprite: {fileID: -763837504473582886, guid: 8e7ec1f4c6271f14c9bc7f1443c80f6a, type: 3}
    content: "\u4F60\u77E5\u9053\u55CE\uFF1F\n\u6211\u662F\u7B2C\u4E00\u6B21\u7528unity\u505A\u904A\u6232"
  - speakerName: "\u5947\u602A\u7684\u760B\u5B50"
    speakerSide: 0
    avatarSprite: {fileID: -763837504473582886, guid: 8e7ec1f4c6271f14c9bc7f1443c80f6a, type: 3}
    content: "\u800C\u4E14\u9084\u53EA\u5B78\u4E86\u56DB\u5929\uFF0C\u54C8\u54C8\uFF01"
  - speakerName: "\u5947\u602A\u7684\u760B\u5B50"
    speakerSide: 0
    avatarSprite: {fileID: -763837504473582886, guid: 8e7ec1f4c6271f14c9bc7f1443c80f6a, type: 3}
    content: "\u53EA\u80FD\u8AAAAI\u9084\u662F\u592A\u5168\u80FD\u4E86\n(\u611F\u6069gemini\u3001\u8B9A\u5606gemini)"
  - speakerName: "\u5947\u602A\u7684\u760B\u5B50"
    speakerSide: 0
    avatarSprite: {fileID: -763837504473582886, guid: 8e7ec1f4c6271f14c9bc7f1443c80f6a, type: 3}
    content: "\u4E0D\u904E\u8173\u672C\u96D6\u662FAI\u5BEB\n\u4E0D\u904E\u4E3B\u610F\u8DDF\u5730\u5716\u9084\u662F\u6211\u624BK\u7684\u5594\uFF01(\u800C\u4E14\u9084\u7279\u610F\u7528unity)"
  - speakerName: "\u5947\u602A\u7684\u760B\u5B50"
    speakerSide: 0
    avatarSprite: {fileID: -763837504473582886, guid: 8e7ec1f4c6271f14c9bc7f1443c80f6a, type: 3}
    content: "\u6211\u53EF\u770B\u4E0D\u4E0A\u7D14\u7528AI\u751F\u6210\u7684\u6771\u6771\uFF0C\u54FC\u54FC~"
