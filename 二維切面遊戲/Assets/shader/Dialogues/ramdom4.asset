    avatarSprite: {fileID: -763837504473582886, guid: 8e7ec1f4c6271f14c9bc7f1443c80f6a, type: 3}
    content: "\u4F60\u7D50\u675F\u4E4B\u5F8C\uFF0C\u6211\u4E5F\u5F97\u53BB\u6D17\u500B\u6FA1\u7761\u89BA\u4E86\n\u4ECA\u5929\u7684\u6BCF\u65E5\u53EF\u9084\u6C92\u6E05"
  - speakerName: "\u5947\u602A\u7684\u760B\u5B50"
    speakerSide: 0
    avatarSprite: {fileID: -763837504473582886, guid: 8e7ec1f4c6271f14c9bc7f1443c80f6a, type: 3}
    content: "\u4F60\u8AAA\u9019\u5730\u65B9\u54EA\u4F86\u7684\u4ECA\u5929\u3001\u660E\u5929\uFF1F\n\u6211\u54EA\u77E5\u9053\uFF0C\u6211\u5C31\u662F\u88AB\u7559\u4E0B\u7684\u7262\u9A37\u800C\u5DF2"
  - speakerName: "\u5947\u602A\u7684\u760B\u5B50"
    speakerSide: 0
    avatarSprite: {fileID: -763837504473582886, guid: 8e7ec1f4c6271f14c9bc7f1443c80f6a, type: 3}
    content: "\u8AB0\u77E5\u9053\u6211\u5230\u5E95\u6B20\u4E86\u591A\u4E45\u7684\u7761\u7720\u6642\u9593\u5462~"
